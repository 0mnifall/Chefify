POSTGRES_DB=chefify_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

BACKEND_HTTP_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

CONNECTION_STRING=Host=db;Port=5432;Database=chefify_db;Username=postgres;Password=postgres

JWT_KEY=change_this_to_a_long_random_secret_at_least_32_chars
JWT_ISSUER=ChefifyAPI
JWT_AUDIENCE=ChefifyClient

ADMIN_EMAIL=admin@chefify.com
ADMIN_PASSWORD=change_this_admin_password

FRONTEND_HTTP_PORT=8088
FRONTEND_PREVIEW_PORT=8089
FLUTTER_VERSION=3.41.9
